# =========================
# CLion & CMake Build Directories
# =========================
# Ignore all CLion build folders (debug, release, relwithdebinfo, etc.)
cmake-build-*/

# Ignore standard CMake build folders (in case you build from terminal later)
build/
out/
bin/
.cmake/

# =========================
# Compiled Binaries
# =========================
# Ignore executables and library files if they escape the build folder
*.exe
*.out
*.app
*.dll
*.so
*.dylib
*.a
*.lib

# =========================
# IDE Settings & OS Trash
# =========================
# CLion project settings folder
.idea/

# Windows thumbnail cache and macOS folder settings
Thumbs.db
.DS_Store